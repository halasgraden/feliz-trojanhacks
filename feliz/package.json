{
  "name": "feliz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @feliz/bot",
    "start": "npm run start -w @feliz/bot",
    "build": "npm run build -w @feliz/db -w @feliz/routing -w @feliz/rag -w @feliz/agent -w @feliz/ingest -w @feliz/bot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
