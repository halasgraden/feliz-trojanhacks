{
  "name": "tenant-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tenant-navigator/bot",
    "build": "npm run build -w @tenant-navigator/db -w @tenant-navigator/routing -w @tenant-navigator/rag -w @tenant-navigator/agent -w @tenant-navigator/ingest -w @tenant-navigator/bot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
