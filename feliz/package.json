{
  "name": "feliz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @feliz/bot",
    "start": "npm run start -w @feliz/bot",
    "build": "npm run build -w @feliz/db -w @feliz/routing -w @feliz/rag -w @feliz/agent -w @feliz/ingest -w @feliz/bot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "rag:check": "npm run build && node scripts/check-local-rag.mjs",
    "rag:query": "npm run build && node scripts/query-local-rag.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
