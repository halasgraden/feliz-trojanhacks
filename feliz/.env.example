# Embeddings run locally; no Google/OpenAI/Hugging Face API key required.
# Optional persistent model cache. Default: your OS temp directory / feliz-models.
# FELIZ_MODEL_CACHE=/absolute/path/to/feliz-models
# Set to 1 after the first download to guarantee no model-network access.
# FELIZ_MODEL_OFFLINE=1

# Required only to upload the corpus to your team database:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_backend_service_role_key

# Required only for Photon messaging:
SPECTRUM_PROJECT_ID=your_spectrum_project_id
SPECTRUM_PROJECT_SECRET=your_spectrum_project_secret

# Optional chat model credential, independent of local embeddings:
GEMINI_API_KEY=
