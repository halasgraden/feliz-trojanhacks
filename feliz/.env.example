# Embeddings (gemini-embedding-001) need ONE of these. When both are set, the service account wins.
# 1) Path to a Google Cloud service account JSON key (Vertex AI; project needs billing). Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_LOCATION=us-central1
# 2) Gemini API key. When this is unset and the service account is set, drafted chat uses Vertex.
# With neither, retrieval falls back to keyword search and the grounded reply quotes those passages.
GEMINI_API_KEY=

# Required only to upload the corpus or search the shared database:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_backend_service_role_key

# Required only for Photon messaging:
SPECTRUM_PROJECT_ID=your_spectrum_project_id
SPECTRUM_PROJECT_SECRET=your_spectrum_project_secret
