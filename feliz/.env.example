# Path to a Google Cloud service account JSON key. Vertex uses it for embeddings and drafted replies.
# The project needs billing. Never commit the file. Leave unset and search uses keywords only;
# the reply then quotes those passages.
GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_LOCATION=us-central1

# Required only to upload the corpus or search the shared database:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_backend_service_role_key

# Required only for Photon messaging:
SPECTRUM_PROJECT_ID=your_spectrum_project_id
SPECTRUM_PROJECT_SECRET=your_spectrum_project_secret
